{
  "name": "claude-usage-monitor",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "service",
    "shared"
  ],
  "scripts": {
    "start": "npm run dev --workspace=service",
    "test": "npm test --workspace=service",
    "typecheck": "tsc --noEmit -p service/tsconfig.json",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9"
  },
  "lint-staged": {
    "*.ts": "prettier --write"
  }
}
