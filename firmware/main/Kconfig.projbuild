menu "Claude Usage Monitor Configuration"

config WIFI_SSID
    string "WiFi SSID"
    default ""
    help
        SSID of the WiFi network to connect to.

config WIFI_PASSWORD
    string "WiFi Password"
    default ""
    help
        WPA2 password for the WiFi network above.

config USAGE_SERVICE_URL
    string "Usage service URL"
    default ""
    help
        Full URL of the claude-usage-monitor service's /usage endpoint.
        Use the dev machine's mDNS/Bonjour hostname (e.g.
        "http://my-mac.local:4317/usage"), not a raw LAN IP - the IP
        changes whenever DHCP reassigns it, which silently breaks polling
        until someone notices and reflashes. The hostname survives that.

endmenu
