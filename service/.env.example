# Copy to service/.env. Every setting here is optional - with no .env at all
# the service runs on port 4317 and works out of the box.

# HTTP port the device polls. Must match the port in the firmware's
# CONFIG_USAGE_SERVICE_URL.
# PORT=4317

# How often to recompute usage, in milliseconds.
# POLL_INTERVAL_MS=15000

# ---------------------------------------------------------------------------
# Live usage API fallback (OFF by default - read before enabling)
# ---------------------------------------------------------------------------
# When Claude Code's local usage cache (~/.claude.json) is stale, this lets the
# service ask Anthropic's undocumented /api/oauth/usage endpoint directly,
# using the OAuth token Claude Code already stores on this machine. It's the
# most accurate option, but Anthropic's Consumer Terms restrict using Claude
# Code's OAuth credentials outside Claude Code itself, so enabling it is at
# your own risk. With it off, stale readings fall back to a local estimate
# (shown on the device as a grey "~" number).
# USE_OAUTH_USAGE_API=1

# ---------------------------------------------------------------------------
# Estimate tuning (only used when no exact number is available)
# ---------------------------------------------------------------------------
# Unset = self-calibrate against your own historical maximum, which needs no
# upkeep. To pin a limit instead, read the percentage from Claude Code's
# /usage panel, compare it with this service's tokensUsed for the same window,
# and set limit = tokensUsed / (percent / 100).
# CLAUDE_SESSION_TOKEN_LIMIT=
# Dollar-cost alternative for the session; takes priority over the token limit.
# CLAUDE_SESSION_COST_LIMIT=
# WEEKLY_TOKEN_LIMIT=

# Any past or future moment your weekly limit resets, in ISO 8601 UTC (from
# the /usage panel's "Resets <day> <time>"). Unset = UTC calendar week.
# WEEKLY_RESET_ANCHOR=2026-01-03T19:00:00Z

# Only if you run Claude Code with a custom config directory.
# CLAUDE_CONFIG_DIR=
